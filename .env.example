# ======================================
# DATABASE
# ======================================
# Local:    postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/smartedu_crm?schema=public
# Supabase: postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/smartedu_crm?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/smartedu_crm?schema=public"

# ======================================
# APP
# ======================================
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-characters-secret
JWT_EXPIRES_IN=7d

# ======================================
# CORS
# ======================================
FRONTEND_URL=http://localhost:3001

# ======================================
# AI SERVICES
# ======================================
AI_DROPOUT_RISK_URL=http://127.0.0.1:8000/predict-dropout

# ======================================
# SUPABASE STORAGE
# ======================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=class-materials
