generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int                  @id @default(autoincrement())
  email            String               @unique @db.VarChar(255)
  password_hash    String               @db.VarChar(255)
  full_name        String               @db.VarChar(255)
  phone            String?              @db.VarChar(20)
  role             UserRole             @default(sale)
  avatar_url       String?              @db.VarChar(500)
  is_active        Boolean              @default(true)
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(6)
  class_materials  class_materials[]
  leadActivities   LeadActivity[]
  assignedLeads    Lead[]               @relation("LeadAssignee")
  receivedPayments PaymentTransaction[] @relation("PaymentReceiver")
  createdPayments  Payment[]            @relation("PaymentCreator")
  issuedReceipts   Receipt[]            @relation("ReceiptIssuer")
  student          Student?
  teacher          Teacher?

  @@index([role])
  @@index([is_active])
  @@map("users")
}

model Lead {
  id             Int            @id @default(autoincrement())
  full_name      String         @db.VarChar(255)
  phone          String?        @db.VarChar(20)
  email          String?        @db.VarChar(255)
  status         LeadStatus     @default(new)
  assigned_to    Int?
  notes          String?
  last_contacted DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  course_id      Int?
  lead_source    String?        @default("other") @db.VarChar(255)
  occupation     String?        @db.VarChar(255)
  study_purpose  String?        @db.VarChar(255)
  activities     LeadActivity[]
  aiScore        LeadAiScore?
  assignedUser   User?          @relation("LeadAssignee", fields: [assigned_to], references: [id])
  course         Course?        @relation("LeadCourseInterested", fields: [course_id], references: [id])
  student        Student?

  @@index([status])
  @@index([lead_source])
  @@index([course_id])
  @@index([assigned_to])
  @@index([createdAt])
  @@map("leads")
}

model LeadActivity {
  id                Int              @id @default(autoincrement())
  lead_id           Int
  user_id           Int?
  type              LeadActivityType
  content           String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)
  engagement_status String?          @db.VarChar(255)
  lead              Lead             @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  user              User?            @relation(fields: [user_id], references: [id])

  @@index([lead_id, type])
  @@index([lead_id, createdAt])
  @@index([user_id])
  @@map("lead_activities")
}

model Student {
  id                 Int               @id @default(autoincrement())
  user_id            Int?              @unique
  lead_id            Int?              @unique
  full_name          String            @db.VarChar(255)
  phone              String?           @db.VarChar(20)
  email              String?           @unique @db.VarChar(255)
  dob                DateTime?         @db.Date
  status             StudentStatus     @default(active)
  enrollment_date    DateTime?         @db.Date
  dropout_risk       Float?
  dropout_risk_level DropoutRiskLevel?
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)
  attendances        Attendance[]
  classEnrollments   ClassEnrollment[]
  invoices           Invoice[]
  payments           Payment[]
  lead               Lead?             @relation(fields: [lead_id], references: [id])
  user               User?             @relation(fields: [user_id], references: [id])
  testResults        TestResult[]

  @@index([status])
  @@index([enrollment_date])
  @@map("students")
}

model Teacher {
  id             Int         @id @default(autoincrement())
  user_id        Int?        @unique
  full_name      String      @db.VarChar(255)
  phone          String?     @db.VarChar(20)
  email          String?     @unique @db.VarChar(255)
  type           TeacherType @default(full_time)
  specialization String?     @db.VarChar(255)
  is_active      Boolean     @default(true)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)
  classes        Class[]
  schedules      Schedule[]
  user           User?       @relation(fields: [user_id], references: [id])

  @@index([is_active])
  @@map("teachers")
}

model Course {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(255)
  description    String?
  total_sessions Int?
  fee            Decimal?  @db.Decimal(15, 2)
  duration_weeks Int?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  is_active      Boolean   @default(true)
  classes        Class[]
  feePlans       FeePlan[]
  leads          Lead[]    @relation("LeadCourseInterested")

  @@map("courses")
}

model Class {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(255)
  course_id        Int?
  teacher_id       Int?
  room_id          Int?
  status           ClassStatus       @default(upcoming)
  start_date       DateTime?         @db.Date
  end_date         DateTime?         @db.Date
  schedule_days    String?           @db.VarChar(255)
  schedule_time    String?           @db.VarChar(255)
  max_students     Int?
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  fee_plan_id      Int?
  classEnrollments ClassEnrollment[]
  class_materials  class_materials[]
  course           Course?           @relation(fields: [course_id], references: [id])
  feePlan          FeePlan?          @relation(fields: [fee_plan_id], references: [id])
  room             Room?             @relation(fields: [room_id], references: [id])
  teacher          Teacher?          @relation(fields: [teacher_id], references: [id])
  invoices         Invoice[]
  payments         Payment[]
  schedules        Schedule[]
  tests            Test[]

  @@index([status])
  @@index([course_id])
  @@index([fee_plan_id])
  @@index([teacher_id])
  @@index([room_id])
  @@map("classes")
}

model FeePlan {
  id          Int           @id @default(autoincrement())
  course_id   Int?
  name        String        @db.VarChar(255)
  description String?
  is_default  Boolean       @default(false)
  is_active   Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  classes     Class[]
  items       FeePlanItem[]
  course      Course?       @relation(fields: [course_id], references: [id])

  @@index([course_id])
  @@index([is_active])
  @@map("fee_plans")
}

model FeePlanItem {
  id          Int             @id @default(autoincrement())
  fee_plan_id Int
  type        InvoiceItemType @default(tuition)
  description String          @db.VarChar(255)
  amount      Decimal         @db.Decimal(15, 2)
  sort_order  Int             @default(0)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)
  feePlan     FeePlan         @relation(fields: [fee_plan_id], references: [id], onDelete: Cascade)

  @@index([fee_plan_id])
  @@map("fee_plan_items")
}

model ClassEnrollment {
  id         Int              @id @default(autoincrement())
  class_id   Int
  student_id Int
  status     EnrollmentStatus @default(active)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(6)
  class      Class            @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([class_id, student_id])
  @@index([student_id])
  @@map("class_enrollments")
}

model Room {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(255)
  capacity  Int?
  equipment String?
  is_active Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  classes   Class[]
  schedules Schedule[]

  @@map("rooms")
}

model Schedule {
  id          Int            @id @default(autoincrement())
  class_id    Int?
  teacher_id  Int?
  room_id     Int?
  date        DateTime       @db.Date
  start_time  DateTime?      @db.Time(6)
  end_time    DateTime?      @db.Time(6)
  status      ScheduleStatus @default(scheduled)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)
  notes       String?
  memo        String?
  attendances Attendance[]
  class       Class?         @relation(fields: [class_id], references: [id], onDelete: Cascade)
  room        Room?          @relation(fields: [room_id], references: [id])
  teacher     Teacher?       @relation(fields: [teacher_id], references: [id])

  @@index([date])
  @@index([class_id])
  @@index([teacher_id])
  @@index([room_id])
  @@map("schedules")
}

model Attendance {
  id          Int              @id @default(autoincrement())
  schedule_id Int
  student_id  Int
  status      AttendanceStatus @default(present)
  notes       String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  schedule    Schedule         @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  student     Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([schedule_id, student_id])
  @@index([student_id])
  @@map("attendances")
}

model Test {
  id          Int          @id @default(autoincrement())
  class_id    Int
  name        String       @db.VarChar(255)
  type        TestType
  max_score   Float?
  test_date   DateTime?    @db.Date
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  testResults TestResult[]
  class       Class        @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@index([class_id])
  @@index([test_date])
  @@map("tests")
}

model TestResult {
  id         Int      @id @default(autoincrement())
  test_id    Int
  student_id Int
  score      Float?
  feedback   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  student    Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  test       Test     @relation(fields: [test_id], references: [id], onDelete: Cascade)

  @@unique([test_id, student_id])
  @@index([student_id])
  @@map("test_results")
}

model Payment {
  id           Int           @id @default(autoincrement())
  student_id   Int
  class_id     Int?
  amount       Decimal       @db.Decimal(15, 2)
  payment_date DateTime?     @db.Date
  method       PaymentMethod @default(cash)
  status       PaymentStatus @default(pending)
  notes        String?
  created_by   Int?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  class        Class?        @relation(fields: [class_id], references: [id])
  creator      User?         @relation("PaymentCreator", fields: [created_by], references: [id])
  student      Student       @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@index([class_id])
  @@index([status])
  @@index([payment_date])
  @@map("payments")
}

model Invoice {
  id              Int                  @id @default(autoincrement())
  invoice_no      String               @unique @db.VarChar(50)
  student_id      Int
  class_id        Int?
  total_amount    Decimal              @db.Decimal(15, 2)
  discount_amount Decimal              @default(0) @db.Decimal(15, 2)
  due_date        DateTime?            @db.Date
  status          InvoiceStatus        @default(pending)
  notes           String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  items           InvoiceItem[]
  class           Class?               @relation(fields: [class_id], references: [id])
  student         Student              @relation(fields: [student_id], references: [id], onDelete: Cascade)
  payments        PaymentTransaction[]
  receipts        Receipt[]

  @@index([student_id])
  @@index([class_id])
  @@index([status])
  @@index([due_date])
  @@map("invoices")
}

model InvoiceItem {
  id          Int             @id @default(autoincrement())
  invoice_id  Int
  type        InvoiceItemType @default(tuition)
  description String          @db.VarChar(255)
  amount      Decimal         @db.Decimal(15, 2)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)
  invoice     Invoice         @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([invoice_id])
  @@map("invoice_items")
}

model PaymentTransaction {
  id             Int           @id @default(autoincrement())
  invoice_id     Int
  amount         Decimal       @db.Decimal(15, 2)
  method         PaymentMethod @default(cash)
  paid_at        DateTime      @default(now()) @db.Timestamptz(6)
  reference_code String?       @db.VarChar(100)
  received_by    Int?
  notes          String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  invoice        Invoice       @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  receiver       User?         @relation("PaymentReceiver", fields: [received_by], references: [id])
  receipts       Receipt[]

  @@index([invoice_id])
  @@index([paid_at])
  @@index([received_by])
  @@map("payment_transactions")
}

model Receipt {
  id             Int                 @id @default(autoincrement())
  receipt_no     String              @unique @db.VarChar(50)
  invoice_id     Int
  transaction_id Int?
  issued_at      DateTime            @default(now()) @db.Timestamptz(6)
  issued_by      Int?
  notes          String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  invoice        Invoice             @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  issuer         User?               @relation("ReceiptIssuer", fields: [issued_by], references: [id])
  transaction    PaymentTransaction? @relation(fields: [transaction_id], references: [id])

  @@index([invoice_id])
  @@index([transaction_id])
  @@index([issued_at])
  @@map("receipts")
}

/// Audit logging table for all raw AI prediction requests/responses.
/// Unlike LeadAiScore which is meant for UI display and business logic, 
/// AIPrediction acts as an append-only historical log for Model Monitoring and Calibration.
model AIPrediction {
  id              Int            @id @default(autoincrement())
  prediction_type PredictionType
  reference_id    Int?
  input_data      Json?
  result_data     Json?
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  @@index([prediction_type])
  @@index([reference_id])
  @@map("ai_predictions")
}

model LeadAiScore {
  id                Int                  @id @default(autoincrement())
  lead_id           Int                  @unique
  probability_score Float
  recommendation    LeadAiRecommendation
  positive_factors  Json?
  negative_factors  Json?
  scored_at         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)
  lead              Lead                 @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([probability_score(sort: Desc)])
  @@map("lead_ai_scores")
}

model class_materials {
  id          Int      @id @default(autoincrement())
  class_id    Int
  title       String
  file_name   String
  file_url    String
  file_type   String?
  file_size   Int?
  uploaded_by Int
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
  classes     Class    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  users       User     @relation(fields: [uploaded_by], references: [id])
}

enum UserRole {
  admin
  sale
  teacher
  student
}

enum LeadStatus {
  new
  contacted
  interested
  trial
  enrolled
  lost
}

enum LeadAiRecommendation {
  HOT_LEAD
  WARM_LEAD
  COLD_LEAD
}

enum LeadActivityType {
  call
  email
  sms
  meeting
  note
  status_change
}

enum StudentStatus {
  active
  inactive
  graduated
  dropped
}

enum DropoutRiskLevel {
  low
  medium
  high
}

enum TeacherType {
  full_time
  part_time
}

enum ClassStatus {
  upcoming
  ongoing
  completed
  cancelled
}

enum EnrollmentStatus {
  active
  dropped
  completed
}

enum ScheduleStatus {
  scheduled
  completed
  cancelled
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum TestType {
  quiz
  midterm
  final
  assignment
}

enum PaymentMethod {
  cash
  bank_transfer
  momo
  vnpay
  other
}

enum PaymentStatus {
  pending
  paid
  refunded
}

enum InvoiceStatus {
  pending
  partial
  paid
  overdue
  cancelled
  refunded
}

enum InvoiceItemType {
  tuition
  registration
  material
  exam
  other
}

enum PredictionType {
  lead_score
  dropout_risk
  revenue_forecast
}
