generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int                  @id @default(autoincrement())
  tenant_id          Int                  @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant             Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  email              String               @db.VarChar(255)
  password_hash      String               @db.VarChar(255)
  full_name          String               @db.VarChar(255)
  phone              String?              @db.VarChar(20)
  role               UserRole             @default(sale)
  avatar_url         String?              @db.VarChar(500)
  is_active          Boolean              @default(true)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)
  class_materials    class_materials[]
  leadActivities     LeadActivity[]
  assignedLeads      Lead[]               @relation("LeadAssignee")
  receivedPayments   PaymentTransaction[] @relation("PaymentReceiver")
  createdPayments    Payment[]            @relation("PaymentCreator")
  issuedReceipts     Receipt[]            @relation("ReceiptIssuer")
  assignmentsCreated Assignment[]         @relation("AssignmentCreator")
  student            Student?
  teacher            Teacher?
  notifications      Notification[]

  @@unique([tenant_id, email])
  @@index([tenant_id, role])
  @@map("users")
}

model Notification {
  id        Int              @id @default(autoincrement())
  tenant_id Int              @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant    Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  user_id   Int
  type      NotificationType @default(general)
  title     String           @db.VarChar(255)
  message   String           @db.Text
  link      String?          @db.VarChar(500)
  is_read   Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  user      User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, user_id, is_read])
  @@index([tenant_id, createdAt(sort: Desc)])
  @@map("notifications")
}

model Lead {
  id             Int            @id @default(autoincrement())
  tenant_id      Int            @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant         Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  full_name      String         @db.VarChar(255)
  phone          String?        @db.VarChar(20)
  email          String?        @db.VarChar(255)
  status         LeadStatus     @default(new)
  assigned_to    Int?
  notes          String?
  last_contacted DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  course_id      Int?
  lead_source    String?        @default("other") @db.VarChar(255)
  occupation     String?        @db.VarChar(255)
  study_purpose  String?        @db.VarChar(255)
  activities     LeadActivity[]
  aiScore        LeadAiScore?
  assignedUser   User?          @relation("LeadAssignee", fields: [assigned_to], references: [id])
  course         Course?        @relation("LeadCourseInterested", fields: [course_id], references: [id])
  student        Student?

  @@unique([tenant_id, id])
  @@index([tenant_id, status, createdAt(sort: Desc)])
  @@index([tenant_id, assigned_to, status])
  @@index([tenant_id, course_id])
  @@index([tenant_id, lead_source])
  @@index([tenant_id, createdAt])
  @@map("leads")
}

model LeadActivity {
  id                Int              @id @default(autoincrement())
  tenant_id         Int              @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant            Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  lead_id           Int
  user_id           Int?
  type              LeadActivityType
  content           String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)
  engagement_status String?          @db.VarChar(255)
  lead              Lead             @relation(fields: [tenant_id, lead_id], references: [tenant_id, id], onDelete: Cascade)
  user              User?            @relation(fields: [user_id], references: [id])

  @@index([tenant_id, lead_id, type])
  @@index([tenant_id, lead_id, createdAt])
  @@index([tenant_id, user_id])
  @@map("lead_activities")
}

model Student {
  id                      Int                    @id @default(autoincrement())
  tenant_id               Int                    @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant                  Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  user_id                 Int?                   @unique
  lead_id                 Int?                   @unique
  full_name               String                 @db.VarChar(255)
  phone                   String?                @db.VarChar(20)
  email                   String?                @db.VarChar(255)
  dob                     DateTime?              @db.Date
  status                  StudentStatus          @default(active)
  enrollment_date         DateTime?              @db.Date
  dropout_risk            Float?
  dropout_risk_level      DropoutRiskLevel?
  dropout_risk_reasons    Json?
  dropout_risk_updated_at DateTime?              @db.Timestamptz(6)
  createdAt               DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime               @updatedAt @db.Timestamptz(6)
  attendances             Attendance[]
  assignmentSubmissions   AssignmentSubmission[]
  classEnrollments        ClassEnrollment[]
  invoices                Invoice[]
  payments                Payment[]
  lead                    Lead?                  @relation(fields: [lead_id], references: [id])
  user                    User?                  @relation(fields: [user_id], references: [id])
  testResults             TestResult[]

  @@unique([tenant_id, email])
  @@unique([tenant_id, id])
  @@index([tenant_id, status])
  @@index([tenant_id, enrollment_date])
  @@map("students")
}

model Teacher {
  id             Int         @id @default(autoincrement())
  tenant_id      Int         @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant         Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  user_id        Int?        @unique
  full_name      String      @db.VarChar(255)
  phone          String?     @db.VarChar(20)
  email          String?     @db.VarChar(255)
  type           TeacherType @default(full_time)
  specialization String?     @db.VarChar(255)
  is_active      Boolean     @default(true)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)
  classes        Class[]
  schedules      Schedule[]
  user           User?       @relation(fields: [user_id], references: [id])

  @@unique([tenant_id, email])
  @@index([tenant_id, is_active])
  @@map("teachers")
}

model Course {
  id             Int       @id @default(autoincrement())
  tenant_id      Int       @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant         Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  name           String    @db.VarChar(255)
  description    String?
  total_sessions Int?
  fee            Decimal?  @db.Decimal(15, 2)
  duration_weeks Int?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  is_active      Boolean   @default(true)
  classes        Class[]
  feePlans       FeePlan[]
  leads          Lead[]    @relation("LeadCourseInterested")

  @@index([tenant_id, is_active])
  @@map("courses")
}

model Class {
  id               Int               @id @default(autoincrement())
  tenant_id        Int               @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant           Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  name             String            @db.VarChar(255)
  course_id        Int?
  teacher_id       Int?
  room_id          Int?
  status           ClassStatus       @default(upcoming)
  start_date       DateTime?         @db.Date
  end_date         DateTime?         @db.Date
  schedule_days    String?           @db.VarChar(255)
  schedule_time    String?           @db.VarChar(255)
  max_students     Int?
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  fee_plan_id      Int?
  classEnrollments ClassEnrollment[]
  class_materials  class_materials[]
  course           Course?           @relation(fields: [course_id], references: [id])
  feePlan          FeePlan?          @relation(fields: [fee_plan_id], references: [id])
  room             Room?             @relation(fields: [room_id], references: [id])
  teacher          Teacher?          @relation(fields: [teacher_id], references: [id])
  invoices         Invoice[]
  payments         Payment[]
  schedules        Schedule[]
  tests            Test[]
  assignments      Assignment[]

  @@unique([tenant_id, id])
  @@index([tenant_id, status])
  @@index([tenant_id, course_id])
  @@index([tenant_id, fee_plan_id])
  @@index([tenant_id, teacher_id])
  @@index([tenant_id, room_id])
  @@map("classes")
}

model FeePlan {
  id          Int           @id @default(autoincrement())
  tenant_id   Int           @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant      Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  course_id   Int?
  name        String        @db.VarChar(255)
  description String?
  is_default  Boolean       @default(false)
  is_active   Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  classes     Class[]
  items       FeePlanItem[]
  course      Course?       @relation(fields: [course_id], references: [id])

  @@unique([tenant_id, id])
  @@index([tenant_id, course_id])
  @@index([tenant_id, is_active])
  @@map("fee_plans")
}

model FeePlanItem {
  id          Int             @id @default(autoincrement())
  tenant_id   Int             @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant      Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  fee_plan_id Int
  type        InvoiceItemType @default(tuition)
  description String          @db.VarChar(255)
  amount      Decimal         @db.Decimal(15, 2)
  sort_order  Int             @default(0)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)
  feePlan     FeePlan         @relation(fields: [tenant_id, fee_plan_id], references: [tenant_id, id], onDelete: Cascade)

  @@index([tenant_id, fee_plan_id])
  @@map("fee_plan_items")
}

model ClassEnrollment {
  id         Int              @id @default(autoincrement())
  tenant_id  Int              @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant     Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  class_id   Int
  student_id Int
  status     EnrollmentStatus @default(active)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(6)
  class      Class            @relation(fields: [tenant_id, class_id], references: [tenant_id, id], onDelete: Cascade)
  student    Student          @relation(fields: [tenant_id, student_id], references: [tenant_id, id], onDelete: Cascade)

  @@unique([class_id, student_id])
  @@index([tenant_id, class_id, status])
  @@index([tenant_id, student_id])
  @@map("class_enrollments")
}

model Room {
  id        Int        @id @default(autoincrement())
  tenant_id Int        @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant    Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  name      String     @db.VarChar(255)
  capacity  Int?
  equipment String?
  is_active Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  classes   Class[]
  schedules Schedule[]

  @@unique([tenant_id, name])
  @@map("rooms")
}

model Schedule {
  id                     Int            @id @default(autoincrement())
  tenant_id              Int            @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant                 Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  class_id               Int?
  teacher_id             Int?
  room_id                Int?
  date                   DateTime       @db.Date
  start_time             DateTime?      @db.Time(6)
  end_time               DateTime?      @db.Time(6)
  status                 ScheduleStatus @default(scheduled)
  createdAt              DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(6)
  notes                  String?
  memo                   String?
  attendances            Attendance[]
  class                  Class?         @relation(fields: [class_id], references: [id], onDelete: Cascade)
  room                   Room?          @relation(fields: [room_id], references: [id])
  teacher                Teacher?       @relation(fields: [teacher_id], references: [id])
  is_attendance_unlocked Boolean        @default(false)
  attendance_unlocked_at DateTime?

  @@unique([tenant_id, id])
  @@index([tenant_id, date])
  @@index([tenant_id, class_id, date])
  @@index([tenant_id, teacher_id, date])
  @@index([tenant_id, room_id, date])
  @@map("schedules")
}

model Attendance {
  id          Int              @id @default(autoincrement())
  tenant_id   Int              @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant      Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  schedule_id Int
  student_id  Int
  status      AttendanceStatus @default(present)
  notes       String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  schedule    Schedule         @relation(fields: [tenant_id, schedule_id], references: [tenant_id, id], onDelete: Cascade)
  student     Student          @relation(fields: [tenant_id, student_id], references: [tenant_id, id], onDelete: Cascade)

  @@unique([schedule_id, student_id])
  @@index([tenant_id, student_id])
  @@map("attendances")
}

model Test {
  id          Int          @id @default(autoincrement())
  tenant_id   Int          @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant      Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  class_id    Int
  name        String       @db.VarChar(255)
  type        TestType
  max_score   Float?
  test_date   DateTime?    @db.Date
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  testResults TestResult[]
  class       Class        @relation(fields: [tenant_id, class_id], references: [tenant_id, id], onDelete: Cascade)

  @@unique([tenant_id, id])
  @@index([tenant_id, class_id])
  @@index([tenant_id, test_date])
  @@map("tests")
}

model TestResult {
  id         Int      @id @default(autoincrement())
  tenant_id  Int      @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  test_id    Int
  student_id Int
  score      Float?
  feedback   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  student    Student  @relation(fields: [tenant_id, student_id], references: [tenant_id, id], onDelete: Cascade)
  test       Test     @relation(fields: [tenant_id, test_id], references: [tenant_id, id], onDelete: Cascade)

  @@unique([test_id, student_id])
  @@index([tenant_id, student_id])
  @@map("test_results")
}

model Assignment {
  id          Int                    @id @default(autoincrement())
  tenant_id   Int                    @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant      Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  class_id    Int
  title       String                 @db.VarChar(255)
  description String?
  due_date    DateTime?              @db.Date
  max_score   Float?
  created_by  Int?
  createdAt   DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(6)
  class       Class                  @relation(fields: [tenant_id, class_id], references: [tenant_id, id], onDelete: Cascade)
  creator     User?                  @relation("AssignmentCreator", fields: [created_by], references: [id])
  submissions AssignmentSubmission[]

  @@unique([tenant_id, id])
  @@index([tenant_id, class_id])
  @@index([tenant_id, due_date])
  @@index([tenant_id, created_by])
  @@map("assignments")
}

model AssignmentSubmission {
  id            Int                        @id @default(autoincrement())
  tenant_id     Int                        @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant        Tenant                     @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  assignment_id Int
  student_id    Int
  submitted_at  DateTime?                  @db.Timestamptz(6)
  score         Float?
  status        AssignmentSubmissionStatus @default(missing)
  feedback      String?
  createdAt     DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                   @updatedAt @db.Timestamptz(6)
  assignment    Assignment                 @relation(fields: [tenant_id, assignment_id], references: [tenant_id, id], onDelete: Cascade)
  student       Student                    @relation(fields: [tenant_id, student_id], references: [tenant_id, id], onDelete: Cascade)

  @@unique([assignment_id, student_id])
  @@index([tenant_id, student_id])
  @@index([tenant_id, status])
  @@map("assignment_submissions")
}

model Payment {
  id           Int           @id @default(autoincrement())
  tenant_id    Int           @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant       Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  student_id   Int
  class_id     Int?
  amount       Decimal       @db.Decimal(15, 2)
  payment_date DateTime?     @db.Date
  method       PaymentMethod @default(cash)
  status       PaymentStatus @default(pending)
  notes        String?
  created_by   Int?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  class        Class?        @relation(fields: [class_id], references: [id])
  creator      User?         @relation("PaymentCreator", fields: [created_by], references: [id])
  student      Student       @relation(fields: [tenant_id, student_id], references: [tenant_id, id], onDelete: Cascade)

  @@index([tenant_id, student_id])
  @@index([tenant_id, class_id])
  @@index([tenant_id, status])
  @@index([tenant_id, payment_date])
  @@map("payments")
}

model Invoice {
  id              Int                  @id @default(autoincrement())
  tenant_id       Int                  @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant          Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  invoice_no      String               @db.VarChar(50)
  student_id      Int
  class_id        Int?
  total_amount    Decimal              @db.Decimal(15, 2)
  discount_amount Decimal              @default(0) @db.Decimal(15, 2)
  due_date        DateTime?            @db.Date
  status          InvoiceStatus        @default(pending)
  notes           String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  items           InvoiceItem[]
  class           Class?               @relation(fields: [class_id], references: [id])
  student         Student              @relation(fields: [tenant_id, student_id], references: [tenant_id, id], onDelete: Cascade)
  payments        PaymentTransaction[]
  receipts        Receipt[]

  @@unique([tenant_id, invoice_no])
  @@unique([tenant_id, id])
  @@index([tenant_id, student_id, status])
  @@index([tenant_id, class_id])
  @@index([tenant_id, status, due_date])
  @@map("invoices")
}

model InvoiceItem {
  id          Int             @id @default(autoincrement())
  tenant_id   Int             @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant      Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  invoice_id  Int
  type        InvoiceItemType @default(tuition)
  description String          @db.VarChar(255)
  amount      Decimal         @db.Decimal(15, 2)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)
  invoice     Invoice         @relation(fields: [tenant_id, invoice_id], references: [tenant_id, id], onDelete: Cascade)

  @@index([tenant_id, invoice_id])
  @@map("invoice_items")
}

model PaymentTransaction {
  id             Int           @id @default(autoincrement())
  tenant_id      Int           @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant         Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  invoice_id     Int
  amount         Decimal       @db.Decimal(15, 2)
  method         PaymentMethod @default(cash)
  paid_at        DateTime      @default(now()) @db.Timestamptz(6)
  reference_code String?       @db.VarChar(100)
  received_by    Int?
  notes          String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  invoice        Invoice       @relation(fields: [tenant_id, invoice_id], references: [tenant_id, id], onDelete: Cascade)
  receiver       User?         @relation("PaymentReceiver", fields: [received_by], references: [id])
  receipts       Receipt[]

  @@index([tenant_id, invoice_id])
  @@index([tenant_id, paid_at])
  @@index([tenant_id, received_by])
  @@map("payment_transactions")
}

model Receipt {
  id             Int                 @id @default(autoincrement())
  tenant_id      Int                 @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant         Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  receipt_no     String              @db.VarChar(50)
  invoice_id     Int
  transaction_id Int?
  issued_at      DateTime            @default(now()) @db.Timestamptz(6)
  issued_by      Int?
  notes          String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  invoice        Invoice             @relation(fields: [tenant_id, invoice_id], references: [tenant_id, id], onDelete: Cascade)
  issuer         User?               @relation("ReceiptIssuer", fields: [issued_by], references: [id])
  transaction    PaymentTransaction? @relation(fields: [transaction_id], references: [id])

  @@unique([tenant_id, receipt_no])
  @@index([tenant_id, invoice_id])
  @@index([tenant_id, transaction_id])
  @@index([tenant_id, issued_at])
  @@map("receipts")
}

/// Audit logging table for all raw AI prediction requests/responses.
/// Unlike LeadAiScore which is meant for UI display and business logic, 
/// AIPrediction acts as an append-only historical log for Model Monitoring and Calibration.
model AIPrediction {
  id              Int            @id @default(autoincrement())
  tenant_id       Int            @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant          Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  prediction_type PredictionType
  reference_id    Int?
  input_data      Json?
  result_data     Json?
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  @@index([tenant_id, prediction_type, createdAt])
  @@index([tenant_id, reference_id])
  @@map("ai_predictions")
}

model LeadAiScore {
  id                Int                  @id @default(autoincrement())
  tenant_id         Int                  @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant            Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  lead_id           Int                  @unique
  probability_score Float
  recommendation    LeadAiRecommendation
  positive_factors  Json?
  negative_factors  Json?
  scored_at         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)
  lead              Lead                 @relation(fields: [tenant_id, lead_id], references: [tenant_id, id], onDelete: Cascade)

  @@unique([tenant_id, lead_id])
  @@index([tenant_id, probability_score(sort: Desc)])
  @@map("lead_ai_scores")
}

model class_materials {
  id          Int      @id @default(autoincrement())
  tenant_id   Int      @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::integer"))
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  class_id    Int
  title       String
  file_name   String
  file_url    String
  file_type   String?
  file_size   Int?
  uploaded_by Int
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  classes     Class    @relation(fields: [tenant_id, class_id], references: [tenant_id, id], onDelete: Cascade)
  users       User     @relation(fields: [uploaded_by], references: [id])

  @@index([tenant_id, class_id])
  @@index([tenant_id, uploaded_by])
}

