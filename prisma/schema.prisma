model SubscriptionPlan {
  id            Int                  @id @default(autoincrement())
  code          String               @unique @db.VarChar(50)
  name          String               @db.VarChar(255)
  price_monthly Decimal              @default(0) @db.Decimal(15, 2)
  max_students  Int?
  max_users     Int?
  features      Json?
  is_active     Boolean              @default(true)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)
  tenants       Tenant[]
  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

model Tenant {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @db.VarChar(255)
  subdomain             String                 @unique @db.VarChar(63)
  status                TenantStatus           @default(trial)
  plan_id               Int?
  contact_email         String?                @db.VarChar(255)
  contact_phone         String?                @db.VarChar(20)
  trial_ends_at         DateTime?              @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  plan                  SubscriptionPlan?      @relation(fields: [plan_id], references: [id])
  subscriptions         TenantSubscription[]
  users                 User[]
  leads                 Lead[]
  leadActivitys         LeadActivity[]
  students              Student[]
  teachers              Teacher[]
  courses               Course[]
  classs                Class[]
  feePlans              FeePlan[]
  feePlanItems          FeePlanItem[]
  classEnrollments      ClassEnrollment[]
  rooms                 Room[]
  schedules             Schedule[]
  attendances           Attendance[]
  tests                 Test[]
  testResults           TestResult[]
  assignments           Assignment[]
  assignmentSubmissions AssignmentSubmission[]
  payments              Payment[]
  invoices              Invoice[]
  invoiceItems          InvoiceItem[]
  paymentTransactions   PaymentTransaction[]
  receipts              Receipt[]
  aIPredictions         AIPrediction[]
  leadAiScores          LeadAiScore[]
  class_materials       class_materials[]
  notifications         Notification[]

  @@index([plan_id])
  @@index([status])
  @@map("tenants")
}

model TenantSubscription {
  id           Int                @id @default(autoincrement())
  tenant_id    Int
  plan_id      Int
  status       SubscriptionStatus @default(active)
  amount       Decimal            @db.Decimal(15, 2)
  period_start DateTime           @db.Timestamptz(6)
  period_end   DateTime           @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)
  tenant       Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan   @relation(fields: [plan_id], references: [id])

  @@index([tenant_id, period_end])
  @@index([plan_id])
  @@map("tenant_subscriptions")
}

/// Platform-level operators (SaaS owner). Not tenant-scoped on purpose.
model PlatformAdmin {
  id            Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  full_name     String   @db.VarChar(255)
  is_active     Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@map("platform_admins")
}
